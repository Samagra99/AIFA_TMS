# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=fto_db
DB_USER=fto_user
DB_PASSWORD=fto_dev_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_DOCUMENTS=fto-documents
MINIO_USE_SSL=False

# ── External APIs ─────────────────────────────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
AAI_NOTAM_API_URL=https://aim.aai.aero/api
DIGITAL_SKY_API_URL=https://digitalsky.dgca.gov.in/api

# ── Firebase (push notifications) ────────────────────────────────────────────
FCM_SERVER_KEY=your-fcm-server-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
